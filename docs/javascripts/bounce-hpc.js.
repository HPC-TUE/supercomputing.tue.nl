(function () {
    // 1. Detect if the user landed here via the old path
    if (window.location.pathname.includes('/hpc-school')) {
        
        // 2. Clear local storage objects to free up browser states
        try {
            window.localStorage.clear();
            window.sessionStorage.clear();
        } catch (e) { console.error(e); }

        // 3. Define the true new target on GitLab Pages
        const newGitLabURL = 'https://hpclab.pages.tue.nl/sites/hpcschool2026/';
        
        // 4. Force a unique timestamp query string (?cb=...)
        // This tricks the browser into thinking it's a completely fresh URL, 
        // bypassing the old cached permanent redirect.
        const cacheBuster = '?cb=' + Date.now();
        
        // 5. Instantly fling the user to the correct site
        window.location.replace(newGitLabURL + cacheBuster);
    }
})();
